# Cloudflare Pages runtime secrets (set these in dashboard; never commit real values)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_KEYWORD=replace-with-a-strong-secret-phrase
JWT_SECRET=replace-with-cryptographically-random-secret-at-least-32-characters
# D1 is configured as a Pages binding named FLASHX_DB; it is not a secret or DATABASE_URL.
